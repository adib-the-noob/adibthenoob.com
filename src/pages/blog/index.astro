---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
  return date.toLocaleDateString("en-US", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  });
}
---

<BaseLayout
  title="Blog · ADIB"
  description="Notes on design, systems, and building calm software."
>
  <section class="border-b border-line-soft/60">
    <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
      <p class="mb-3 font-mono text-sm tracking-wide text-primary">[ writing ]</p>
      <h1 class="max-w-[16ch] font-display text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Notes from the workbench
      </h1>
      <p class="mt-6 max-w-xl text-lg leading-relaxed text-muted">
        Short essays on design, systems, and shipping software that respects attention.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    {
      posts.length === 0 ? (
        <p class="font-mono text-sm text-faint">No posts yet.</p>
      ) : (
        <ul class="divide-y divide-line-soft">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}/`}
                class="group grid gap-3 py-8 transition-colors hover:bg-raised/40 md:grid-cols-12 md:gap-6 md:px-4"
              >
                <time
                  datetime={post.data.pubDate.toISOString()}
                  class="font-mono text-sm text-faint md:col-span-2"
                >
                  {formatDate(post.data.pubDate)}
                </time>
                <span class="md:col-span-7">
                  <span class="block text-xl font-medium tracking-tight text-body">
                    {post.data.title}
                    <span class="ml-2 inline-block align-middle font-mono text-sm leading-none text-faint opacity-0 transition-opacity group-hover:opacity-100">
                      &rarr;
                    </span>
                  </span>
                  <span class="mt-2 block max-w-prose text-sm leading-relaxed text-muted">
                    {post.data.description}
                  </span>
                </span>
                <span class="font-mono text-sm text-faint md:col-span-3 md:text-right">
                  {post.data.tags.join(" · ")}
                </span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>
</BaseLayout>
