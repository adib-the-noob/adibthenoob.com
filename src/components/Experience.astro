---
import { getCollection } from "astro:content";

// One markdown file per job in src/content/experience/ — add, edit or
// draft entries there and this section picks them up automatically.
const jobs = (await getCollection("experience", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

// Official brand colors for the tool pills (dot inside each pill);
// anything unmapped falls back to the site violet.
const TOOL_COLORS: Record<string, string> = {
  Django: "#44b78b",
  DRF: "#d6322e",
  FastAPI: "#009688",
  Laravel: "#ff2d20",
  "Laravel 9": "#ff2d20",
  Blade: "#f05340",
  Celery: "#a9cc50",
  Channels: "#57b8e0",
  PostgreSQL: "#336791",
  MariaDB: "#003545",
  MySQL: "#00758f",
  Redis: "#d82c20",
  Docker: "#2496ed",
  Nginx: "#009639",
  AWS: "#ff9900",
  Bootstrap: "#7952b3",
  Firebase: "#ffca28",
};
---

<section id="experience" class="scroll-mt-24 border-t border-line-soft/60">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div
      data-reveal
      class="mb-14 flex flex-wrap items-end justify-between gap-6"
    >
      <div>
        <p class="mb-3 font-mono text-sm tracking-wide text-primary">
          [ 01 · experience ]
        </p>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Where I&rsquo;ve worked
        </h2>
      </div>
      <p class="max-w-xs font-mono text-sm text-faint">
        Four teams, one through-line: systems that stay standing.
      </p>
    </div>

    <ol class="space-y-12 border-l border-line-soft pl-6 md:pl-10" data-stagger>
      {
        jobs.map((job) => (
          <li class="relative">
            <span
              class="absolute top-[7px] block h-2.5 w-2.5 rounded-full border border-primary bg-canvas md:-left-[calc(2.5rem+5px)] -left-[31px]"
              aria-hidden="true"
            />
            <div class="grid gap-3 md:grid-cols-12 md:gap-6">
              <p class="font-mono text-sm text-faint md:col-span-3">
                {job.data.period}
                {job.data.location && (
                  <span class="mt-1 block text-xs">{job.data.location}</span>
                )}
              </p>
              <div class="md:col-span-9">
                <h3 class="text-xl font-medium tracking-tight text-body">
                  {job.data.role}
                </h3>
                <p class="mt-2 flex flex-wrap items-center gap-2.5">
                  {
                    job.data.companyUrl ? (
                      <a
                        href={job.data.companyUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class:list={[
                          "company-chip inline-block",
                          // #ffffff opts into the inverted black-and-white chip
                          job.data.companyColor?.toLowerCase() === "#ffffff" && "mono-chip",
                        ]}
                        style={job.data.companyColor ? { "--company": job.data.companyColor } : undefined}
                        data-split
                      >
                        {job.data.company}
                      </a>
                    ) : (
                      <span
                        class:list={[
                          "company-chip inline-block",
                          job.data.companyColor?.toLowerCase() === "#ffffff" && "mono-chip",
                        ]}
                        style={job.data.companyColor ? { "--company": job.data.companyColor } : undefined}
                        data-split
                      >
                        {job.data.company}
                      </span>
                    )
                  }
                  {job.data.tag && (
                    <span class="font-mono text-sm text-faint">
                      {job.data.tag}
                    </span>
                  )}
                </p>
                {job.data.bullets.length > 0 && (
                  <ul class="mt-4 space-y-2.5 text-[0.95rem] leading-relaxed text-muted">
                    {job.data.bullets.map((bullet) => (
                      <li class="measure flex gap-3">
                        <span
                          class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-faint"
                          aria-hidden="true"
                        />
                        <span>{bullet}</span>
                      </li>
                    ))}
                  </ul>
                )}
                {job.data.tools.length > 0 && (
                  <ul class="mt-5 flex flex-wrap gap-2">
                    {job.data.tools.map((tool) => (
                      <li class="flex items-center gap-1.5 rounded-full border border-line bg-elevated px-3 py-1 font-mono text-xs text-muted transition-all hover:-translate-y-0.5 hover:border-primary/50 hover:text-body">
                        <span
                          class="h-1.5 w-1.5 rounded-full"
                          style={{
                            backgroundColor:
                              TOOL_COLORS[tool] ?? "var(--color-primary)",
                          }}
                          aria-hidden="true"
                        />
                        {tool}
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div
      data-reveal
      class="mt-14 rounded-lg border border-line bg-raised p-6 md:flex md:items-center md:justify-between md:gap-6"
    >
      <div>
        <p class="font-mono text-xs tracking-[0.25em] text-faint uppercase">
          Education
        </p>
        <p class="mt-2 text-lg font-medium text-body">
          Daffodil International University
        </p>
        <p class="text-sm text-muted">B.Sc. in Software Engineering</p>
      </div>
      <div class="mt-4 font-mono text-sm text-faint md:mt-0 md:text-right">
        <p>May 2025 — June 2029</p>
        <p class="mt-1">CGPA 3.83</p>
      </div>
    </div>
  </div>
</section>
