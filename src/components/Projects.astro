---
import { getCollection } from "astro:content";

const projects = (await getCollection("projects", ({ data }) => !data.draft))
  .sort((a, b) => a.data.sortOrder - b.data.sortOrder);

const statusColor: Record<string, string> = {
  live: "bg-ok",
  wip: "bg-warn",
  archive: "bg-faint",
};
---

<section id="projects" class="scroll-mt-24 border-t border-line-soft/60">
  <div class="mx-auto max-w-6xl px-6 py-24">
    <div
      data-reveal
      class="mb-14 flex flex-wrap items-end justify-between gap-6"
    >
      <div>
        <p class="mb-3 font-mono text-sm tracking-wide text-primary">
          [ 02 · projects ]
        </p>
        <h2 class="font-display text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
          Things I&rsquo;ve built
        </h2>
      </div>
      <p class="max-w-xs font-mono text-sm text-faint">
        Selected builds — each one earned its lesson. Full write-ups inside.
      </p>
    </div>

    <div class="grid gap-6 md:grid-cols-2" data-stagger>
      {
        projects.map((project) => (
          <a
            href={`/projects/${project.id}/`}
            class="group flex flex-col rounded-lg border border-line bg-raised p-6 transition-colors hover:border-primary/60 hover:bg-raised/80"
          >
            <div class="flex items-center justify-between">
              <p class="font-mono text-sm text-faint">
                {project.data.period ?? "—"}
              </p>
              <span class="flex items-center gap-2 font-mono text-xs text-faint">
                <span
                  class={`h-1.5 w-1.5 rounded-full ${statusColor[project.data.status] ?? "bg-faint"}`}
                />
                {project.data.status}
              </span>
            </div>

            <h3 class="mt-4 text-xl font-medium tracking-tight text-body">
              {project.data.title}
              <span class="ml-2 inline-block align-middle font-mono text-sm leading-none text-faint opacity-0 transition-opacity group-focus-within:opacity-100 group-hover:opacity-100">
                &rarr;
              </span>
            </h3>

            <p class="mt-3 flex-1 text-[0.95rem] leading-relaxed text-muted">
              {project.data.description}
            </p>

            {project.data.tools.length > 0 && (
              <ul class="mt-5 flex flex-wrap gap-2">
                {project.data.tools.map((tool) => (
                  <li class="rounded-full border border-line bg-elevated px-3 py-1 font-mono text-xs text-muted">
                    {tool}
                  </li>
                ))}
              </ul>
            )}
          </a>
        ))
      }
    </div>
  </div>
</section>
