<section id="top" class="relative overflow-x-clip">
  <!-- deep-space glow — bleeds up behind the transparent navbar so the
       purple starts at the very top edge of the page -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0">
    <div
      class="absolute inset-x-0 -top-32 h-96 bg-gradient-to-b from-primary/35 via-primary/10 to-transparent"
    >
    </div>
    <div
      data-glow
      class="absolute -top-40 right-[-10%] h-[34rem] w-[34rem] rounded-full bg-primary/20 blur-[120px]"
    >
    </div>
    <div
      class="absolute bottom-[-20%] left-[-10%] h-[28rem] w-[28rem] rounded-full bg-accent/10 blur-[120px]"
    >
    </div>
  </div>

  <div class="relative mx-auto grid max-w-6xl gap-12 px-6 pt-16 pb-24 lg:grid-cols-12 md:pt-20 md:pb-32">
    <!-- Lead copy -->
    <div class="min-w-0 lg:col-span-7">
      <p
        data-hero-anim
        data-hero-eyebrow
        class="mb-5 font-mono text-sm tracking-wide text-primary"
      >
        [ Backend Engineer · Dhaka, Bangladesh ]
      </p>
      <h1
        data-hero-title
        class="max-w-[22ch] font-display text-5xl font-semibold leading-[1.05] tracking-tight text-balance sm:text-6xl lg:text-7xl"
      >
        <span class="hero-word" data-hero-anim>Adib</span>{" "}
        <span class="hero-word" data-hero-anim>builds</span>{" "}
        <span class="hero-word" data-hero-anim>backends</span>{" "}
        <span class="hero-word" data-hero-anim>that</span>{" "}
        <span class="hero-word" data-hero-anim>hold</span>{" "}
        <span class="hero-word" data-hero-anim>their</span>{" "}
        <span class="hero-word" data-hero-anim>shape</span>{" "}
        <span class="hero-word" data-hero-anim>under</span>{" "}
        <span class="hero-word" data-hero-anim>load.</span>
      </h1>
      <p
        data-hero-anim
        data-hero-sub
        class="mt-6 max-w-[46ch] text-lg leading-relaxed text-muted"
      >
        Adib Bin Billal — backend software engineer, aka
        <a
          href="https://github.com/adib-the-noob"
          class="whitespace-nowrap text-body underline decoration-line underline-offset-4 transition-colors hover:text-primary"
          >@adib-the-noob</a
        >. I design the systems behind the interface: multi-tenant billing,
        resource orchestration, and APIs that stay reliable when the traffic
        arrives. Currently engineering MetroVPS at Flarezen.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-4" data-hero-cta>
        <a
          data-hero-anim
          href="#projects"
          class="rounded-full bg-primary px-6 py-3 font-mono text-sm font-medium text-ink transition-transform hover:-translate-y-0.5"
        >
          See the work
        </a>
        <a
          data-hero-anim
          href="#contact"
          class="rounded-full border border-line bg-elevated px-6 py-3 font-mono text-sm text-body transition-colors hover:border-primary"
        >
          Get in touch
        </a>
      </div>
    </div>

    <!-- Proof object: live status panel -->
    <div class="min-w-0 lg:col-span-5 lg:pt-10">
      <div
        data-hero-anim
        data-hero-card
        class="rounded-lg border border-line bg-raised p-6 shadow-[0_0_60px_-20px_var(--color-primary)] sm:p-7"
      >
        <div class="flex items-center justify-between">
          <span class="flex items-center gap-2 font-mono text-xs text-faint">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span
                class="absolute inline-flex h-full w-full animate-ping rounded-full bg-ok opacity-60"
              ></span>
              <span class="relative inline-flex h-2 w-2 rounded-full bg-ok"></span>
            </span>
            status: available
          </span>
          <span class="font-mono text-xs text-faint">dhaka · gmt+6</span>
        </div>

        <div class="mt-6">
          <p class="font-mono text-xs tracking-[0.25em] text-faint uppercase">
            Currently
          </p>
          <p class="mt-2 font-display text-xl font-medium tracking-tight text-body">
            Software Engineer L2
          </p>
          <p class="mt-1 text-sm text-muted">
            <a
              href="https://metrovps.com"
              target="_blank"
              rel="noopener noreferrer"
              class="text-primary underline-offset-4 transition-colors hover:underline"
              >Flarezen Ltd.</a
            >
            — @MetroVPS
          </p>
          <p class="mt-1 font-mono text-xs text-faint">feb 2026 — present</p>
        </div>

        <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-line-soft pt-6">
          <div>
            <dd class="font-display text-2xl font-semibold text-body">3+</dd>
            <dt class="mt-1 font-mono text-xs text-faint">yrs shipping</dt>
          </div>
          <div>
            <dd class="font-display text-2xl font-semibold text-body">10k+</dd>
            <dt class="mt-1 font-mono text-xs text-faint">customers served</dt>
          </div>
          <div>
            <dd class="font-display text-2xl font-semibold text-body">4</dd>
            <dt class="mt-1 font-mono text-xs text-faint">teams</dt>
          </div>
        </dl>

        <div class="mt-6 border-t border-line-soft pt-6">
          <p class="font-mono text-xs tracking-[0.25em] text-faint uppercase">
            Focus
          </p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              ["billing", "multi-tenancy", "rest apis", "realtime", "aws"].map(
                (chip) => (
                  <li class="rounded-full border border-line bg-elevated px-3 py-1 font-mono text-xs text-muted">
                    {chip}
                  </li>
                ),
              )
            }
          </ul>
        </div>

        <p class="mt-6 flex items-center justify-between border-t border-line-soft pt-5 font-mono text-xs text-faint">
          <span>local time</span>
          <span>
            <span id="dhaka-clock">--:--:--</span> gmt+6
          </span>
        </p>
      </div>
    </div>
  </div>

  <!-- Section seam: subtle imprint -->
  <div class="hidden md:block" aria-hidden="true">
    <p class="mx-auto max-w-6xl px-6 pb-10 font-mono text-xs tracking-[0.3em] text-faint uppercase">
      Portfolio  —  ADIB  —  2026
    </p>
  </div>
</section>
