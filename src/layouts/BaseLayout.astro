---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "ADIB — Backend Software Engineer",
  description = "Mohammed Adib is a backend software engineer in Dhaka building reliable, scalable platforms with Django, Laravel and AWS. Selected work, writing and experience.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <!-- Flags JS before first paint so [data-reveal] initial states
         never flash for no-JS visitors (CSS gates on html.js). -->
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body class="min-h-screen bg-canvas text-body antialiased">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import "../scripts/animations";
    </script>
  </body>
</html>
